# Optional Cloudflare Worker URL lookup endpoint; leave empty for local-only checks.
VITE_WORKER_URL=

# EmailJS feedback configuration. Never put provider secrets in this frontend.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Public operator details displayed in the privacy notice (not secrets).
VITE_PRIVACY_OPERATOR=
VITE_PRIVACY_EMAIL=
